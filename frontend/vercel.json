
{
  "version": 2,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/messages.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/cv",
      "destination": "/cv.html",
      "permanent": false
    },
    {
      "source": "/resume",
      "destination": "/cv.html",
      "permanent": false
    },
    {
      "source": "/message.html",
      "destination": "/messages.html",
      "permanent": false
    }
  ]
}
